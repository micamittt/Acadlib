    private void returnSelectedBook() {
        if (table == null || table.getSelectedRow() < 0) {
            error("Please select a borrowed book first.");
            return;
        }

        int row = table.convertRowIndexToModel(table.getSelectedRow());

        int bookId = Integer.parseInt(
            String.valueOf(table.getModel().getValueAt(row, 0))
        );

        int userId = LibrarySystemm.currentUserId;

        int confirm = JOptionPane.showConfirmDialog(
            this,
            "Are you sure you want to return this book?",
            "Confirm Return",
            JOptionPane.YES_NO_OPTION
        );

        if (confirm != JOptionPane.YES_OPTION) return;

        Connection conn = LibrarySystemm.conn;

        try {
            conn.setAutoCommit(false);

            String updateBorrowing =
                "UPDATE BorrowingRecords "
                + "SET status = 'Returned', return_date = NOW() "
                + "WHERE user_id = ? AND book_id = ? "
                + "AND status = 'Borrowed' AND return_date IS NULL";

            int updated;

            try (PreparedStatement ps =
                     conn.prepareStatement(updateBorrowing)) {

                ps.setInt(1, userId);
                ps.setInt(2, bookId);

                updated = ps.executeUpdate();
            }

            if (updated == 0) {
                conn.rollback();
                error("No active borrowing record was found.");
                return;
            }

            String updateBook =
                "UPDATE Books SET available = TRUE WHERE book_id = ?";

            try (PreparedStatement ps =
                     conn.prepareStatement(updateBook)) {

                ps.setInt(1, bookId);
                ps.executeUpdate();
            }

            conn.commit();

            LibrarySystemm.recordUserActivity(
                "Returned book ID: " + bookId
            );

            LibrarySystemm.refreshData();

            message("Book returned successfully!");
            showTransactions();

        } catch (SQLException ex) {
            try {
                conn.rollback();
            } catch (SQLException rollbackError) {
                ex.addSuppressed(rollbackError);
            }

            error("Return failed: " + ex.getMessage());

        } finally {
            try {
                conn.setAutoCommit(true);
            } catch (SQLException ex) {
                error("Database connection error: " + ex.getMessage());
            }
        }
    }

    // VIRTUAL LIBRARY CARD

    private void showLibraryCard() {
        LibrarySystemm.User u = activeUser();

        DefaultTableModel m = model(
            new String[]{"Card Information", "Details"}
        );

        String sql =
            "SELECT card_number, status FROM LibraryCards WHERE user_id = ?";

        try (PreparedStatement ps =
                 LibrarySystemm.conn.prepareStatement(sql)) {

            ps.setInt(1, LibrarySystemm.currentUserId);

            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    m.addRow(new Object[]{"University", "PUP"});
                    m.addRow(new Object[]{"Name", u.name});
                    m.addRow(new Object[]{"ID Number", u.idNumber});
                    m.addRow(new Object[]{"Card Number",
                        rs.getString("card_number")});
                    m.addRow(new Object[]{"Status",
                        rs.getString("status")});
                }
            }

        } catch (SQLException ex) {
            error("Could not load library card: " + ex.getMessage());
        }

        page("Virtual Library Card", tablePanel(makeTable(m)));
    }

    // ADMIN LOGS

    private void showLogs() {
        DefaultTableModel m = model(
            new String[]{"Name", "ID Number", "Account", "Activity", "Date"}
        );

        String sql =
            "SELECT u.name, u.id_number, u.category, "
            + "l.activity, l.activity_date "
            + "FROM UserLogs l JOIN Users u ON l.user_id = u.user_id "
            + "ORDER BY l.activity_date DESC";

        try (PreparedStatement ps =
                 LibrarySystemm.conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                m.addRow(new Object[]{
                    rs.getString("name"),
                    rs.getString("id_number"),
                    rs.getString("category"),
                    rs.getString("activity"),
                    rs.getString("activity_date")
                });
            }

        } catch (SQLException ex) {
            error("Could not load logs: " + ex.getMessage());
        }

        page("User Activity Logs", tablePanel(makeTable(m)));
    }

    // ADMIN USERS

    private void showUsers() {
        LibrarySystemm.loadUsers();

        DefaultTableModel m = model(
            new String[]{
                "Name", "Category", "ID Number",
                "Age", "Program and Year", "Email"
            }
        );

        for (LibrarySystemm.User u : LibrarySystemm.users) {
            m.addRow(new Object[]{
                u.name, u.category, u.idNumber,
                u.age, u.programYear, u.email
            });
        }

        page("Registered Users", tablePanel(makeTable(m)));
    }

    private void logout() {
        LibrarySystemm.recordUserActivity("Signed out");

        LibrarySystemm.currentUser = -1;
        LibrarySystemm.currentUserId = -1;

        LibrarySystemm.borrowedBooks.clear();
        LibrarySystemm.reservations.clear();

        showLogin();
    }

    // HELPERS

    private LibrarySystemm.User activeUser() {
        int index = LibrarySystemm.currentUser;

        if (index < 0 || index >= LibrarySystemm.users.size()) {
            return null;
        }

        return LibrarySystemm.users.get(index);
    }

    private boolean isAdmin() {
        LibrarySystemm.User u = activeUser();

        return u != null
            && u.category.equalsIgnoreCase("admin");
    }

    private DefaultTableModel model(String[] columns) {
        return new DefaultTableModel(columns, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false;
            }
        };
    }

    private JTable makeTable(DefaultTableModel model) {
        JTable t = new JTable(model);
        t.setRowHeight(36);
        t.setFont(new Font("Arial", Font.PLAIN, 13));
        t.setSelectionBackground(new Color(245, 225, 225));
        t.setSelectionForeground(TEXT);
        t.getTableHeader().setFont(new Font("Arial", Font.BOLD, 13));
        t.getTableHeader().setBackground(new Color(242, 242, 242));
        t.getTableHeader().setPreferredSize(new Dimension(0, 38));
        return t;
    }

    private JPanel tablePanel(JTable t) {
        JPanel p = new JPanel(new BorderLayout(0, 12));
        p.setOpaque(false);

        JPanel card = new JPanel(new BorderLayout());
        card.setBackground(WHITE);
        card.setBorder(new EmptyBorder(12, 12, 12, 12));
        card.add(new JScrollPane(t), BorderLayout.CENTER);

        p.add(card, BorderLayout.CENTER);
        return p;
    }

