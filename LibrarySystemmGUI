    private boolean login(String email, String password, String category) {
        String sql = "SELECT user_id FROM Users "
                   + "WHERE email = ? AND password = ? AND category = ?";

        try (PreparedStatement ps =
                 LibrarySystemm.conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, password);
            ps.setString(3, category);

            try (ResultSet rs = ps.executeQuery()) {
                if (!rs.next()) return false;

                LibrarySystemm.currentUserId = rs.getInt("user_id");
                LibrarySystemm.refreshData();

                LibrarySystemm.currentUser = -1;

                for (int i = 0; i < LibrarySystemm.users.size(); i++) {
                    if (LibrarySystemm.users.get(i).id
                            == LibrarySystemm.currentUserId) {
                        LibrarySystemm.currentUser = i;
                        break;
                    }
                }

                if (LibrarySystemm.currentUser == -1) {
                    return false;
                }

                LibrarySystemm.recordUserActivity("Signed in");
                return true;
            }

        } catch (SQLException ex) {
            error("Login error: " + ex.getMessage());
            return false;
        }
    }

    private void showRegister() {
        JTextField name = new JTextField();
        JTextField id = new JTextField();
        JTextField age = new JTextField();
        JTextField program = new JTextField();
        JTextField email = new JTextField();
        JPasswordField password = new JPasswordField();

        JPanel form = new JPanel(new GridLayout(6, 2, 9, 9));

        form.add(new JLabel("Name:"));
        form.add(name);
        form.add(new JLabel("ID Number:"));
        form.add(id);
        form.add(new JLabel("Age:"));
        form.add(age);
        form.add(new JLabel("Program and Year:"));
        form.add(program);
        form.add(new JLabel("Email:"));
        form.add(email);
        form.add(new JLabel("Password:"));
        form.add(password);

        int result = JOptionPane.showConfirmDialog(
            this, form, "Register Student Account",
            JOptionPane.OK_CANCEL_OPTION
        );

        if (result != JOptionPane.OK_OPTION) return;

        try {
            if (name.getText().trim().isEmpty()
                    || id.getText().trim().isEmpty()
                    || age.getText().trim().isEmpty()
                    || program.getText().trim().isEmpty()
                    || email.getText().trim().isEmpty()
                    || password.getPassword().length == 0) {
                error("Please complete all fields.");
                return;
            }

            int userAge = Integer.parseInt(age.getText().trim());

            if (userAge <= 0) {
                error("Enter a valid age.");
                return;
            }

            String sql = "INSERT INTO Users "
                + "(category, name, id_number, age, program_year, email, password) "
                + "VALUES ('student', ?, ?, ?, ?, ?, ?)";

            try (PreparedStatement ps =
                LibrarySystemm.conn.prepareStatement(
                    sql, Statement.RETURN_GENERATED_KEYS)) {

                ps.setString(1, name.getText().trim());
                ps.setString(2, id.getText().trim());
                ps.setInt(3, userAge);
                ps.setString(4, program.getText().trim());
                ps.setString(5, email.getText().trim());
                ps.setString(6, new String(password.getPassword()));

                ps.executeUpdate();

                try (ResultSet keys = ps.getGeneratedKeys()) {
                    if (keys.next()) {
                        int userId = keys.getInt(1);

                        String cardSQL =
                            "INSERT INTO LibraryCards (user_id, card_number) "
                            + "VALUES (?, ?)";

                        try (PreparedStatement cardPS =
                            LibrarySystemm.conn.prepareStatement(cardSQL)) {

                            cardPS.setInt(1, userId);
                            cardPS.setString(
                                2, "LIB-" + userId + "-" + id.getText().trim()
                            );
                            cardPS.executeUpdate();
                        }
                    }
                }

                message("Registration successful!");
            }

        } catch (NumberFormatException ex) {
            error("Age must be a number.");
        } catch (SQLException ex) {
            error("Registration failed: " + ex.getMessage());
        }
    }

