    private LibrarySystemm.Book selectedBook() {
        if (table == null || table.getSelectedRow() < 0) {
            error("Please select a book first.");
            return null;
        }

        int row = table.convertRowIndexToModel(table.getSelectedRow());

        int id = Integer.parseInt(
            String.valueOf(table.getModel().getValueAt(row, 0))
        );

        LibrarySystemm.refreshData();

        return LibrarySystemm.findBook(id);
    }

    private void borrowSelectedBook() {
        LibrarySystemm.Book b = selectedBook();
        if (b == null) return;

        if (!activeUser().category.equalsIgnoreCase("student")) {
            error("Only student accounts can borrow books.");
            return;
        }

        if (LibrarySystemm.borrowForGUI(b.id)) {
            message("Book borrowed successfully!");
        } else {
            error("Borrowing failed. Check book availability and your borrowing limit.");
        }

        refreshCurrentBookPage();
    }

    // RESERVATION

    private void reserveSelectedBook() {
        LibrarySystemm.Book b = selectedBook();
        if (b == null) return;

        if (!activeUser().category.equalsIgnoreCase("student")) {
            error("Only student accounts can reserve books.");
            return;
        }

        JTextField dateField = new JTextField(
            LocalDate.now().toString()
        );

        JTextField timeField = new JTextField("04:00 PM");

        JPanel form = new JPanel(new GridLayout(2, 2, 8, 8));

        form.add(new JLabel("Reservation Date (YYYY-MM-DD):"));
        form.add(dateField);

        form.add(new JLabel("Reservation Time (HH:MM AM/PM):"));
        form.add(timeField);

        int result = JOptionPane.showConfirmDialog(
            this,
            form,
            "Reserve: " + b.title,
            JOptionPane.OK_CANCEL_OPTION,
            JOptionPane.PLAIN_MESSAGE
        );

        if (result != JOptionPane.OK_OPTION) return;

        try {
            LocalDate date = LocalDate.parse(dateField.getText().trim());

            String enteredTime = timeField.getText().trim();
            LocalTime time;

            try {
                time = LocalTime.parse(
                    enteredTime,
                    DateTimeFormatter.ofPattern("h:mm a")
                );
            } catch (DateTimeParseException ex) {
                time = LocalTime.parse(enteredTime);
            }

            if (date.isBefore(LocalDate.now())) {
                error("Reservation date cannot be in the past.");
                return;
            }

            if (time.isAfter(LocalTime.of(17, 0))) {
                error("Reservations must be scheduled no later than 5:00 PM.");
                return;
            }

            if (date.equals(LocalDate.now())
                    && time.isBefore(LocalTime.now())) {
                error("Please choose a future reservation time.");
                return;
            }

            String checkSQL =
                "SELECT reservation_id FROM Reservations "
                + "WHERE user_id = ? AND book_id = ? AND status = 'Active'";

            try (PreparedStatement check =
                     LibrarySystemm.conn.prepareStatement(checkSQL)) {

                check.setInt(1, LibrarySystemm.currentUserId);
                check.setInt(2, b.id);

                try (ResultSet rs = check.executeQuery()) {
                    if (rs.next()) {
                        error("You already have an active reservation for this book.");
                        return;
                    }
                }
            }

            String sql =
                "INSERT INTO Reservations "
                + "(user_id, book_id, reservation_date, reservation_time, status) "
                + "VALUES (?, ?, ?, ?, 'Active')";

            try (PreparedStatement ps =
                     LibrarySystemm.conn.prepareStatement(sql)) {

                ps.setInt(1, LibrarySystemm.currentUserId);
                ps.setInt(2, b.id);
                ps.setDate(3, Date.valueOf(date));
                ps.setTime(4, Time.valueOf(time));

                ps.executeUpdate();
            }

            LibrarySystemm.recordUserActivity(
                "Reserved book: " + b.title
            );

            LibrarySystemm.refreshData();

            message("Reservation successful!\n\n"
                + "Book: " + b.title
                + "\nDate: " + date
                + "\nTime: " + time);

            refreshCurrentBookPage();

        } catch (DateTimeParseException ex) {
            error("Invalid date or time. Please use YYYY-MM-DD and 04:00 PM.");
        } catch (SQLException ex) {
            error("Reservation failed: " + ex.getMessage());
        }
    }

    // ADMIN BOOK MANAGEMENT

    private void editSelectedBook() {
        LibrarySystemm.Book b = selectedBook();
        if (b == null) return;

        JTextField title = new JTextField(b.title);
        JTextField author = new JTextField(b.author);

        JComboBox<String> category = new JComboBox<>(
            new String[]{"Scholarly", "Research", "Capstone"}
        );

        category.setSelectedItem(b.category);

        JPanel form = new JPanel(new GridLayout(3, 2, 8, 8));

        form.add(new JLabel("Title:"));
        form.add(title);

        form.add(new JLabel("Author:"));
        form.add(author);

        form.add(new JLabel("Category:"));
        form.add(category);

        int result = JOptionPane.showConfirmDialog(
            this, form, "Edit Book",
            JOptionPane.OK_CANCEL_OPTION
        );

        if (result != JOptionPane.OK_OPTION) return;

        if (title.getText().trim().isEmpty()
                || author.getText().trim().isEmpty()) {
            error("Title and author cannot be blank.");
            return;
        }

        String sql =
            "UPDATE Books SET title = ?, author = ?, category = ? "
            + "WHERE book_id = ?";

        try (PreparedStatement ps =
                 LibrarySystemm.conn.prepareStatement(sql)) {

            ps.setString(1, title.getText().trim());
            ps.setString(2, author.getText().trim());
            ps.setString(3, String.valueOf(category.getSelectedItem()));
            ps.setInt(4, b.id);

            ps.executeUpdate();

            LibrarySystemm.recordUserActivity("Edited book: " + b.title);
            LibrarySystemm.refreshData();

            message("Book updated successfully.");
            refreshCurrentBookPage();

        } catch (SQLException ex) {
            error("Edit failed: " + ex.getMessage());
        }
    }

    private void removeSelectedBook() {
        LibrarySystemm.Book b = selectedBook();
        if (b == null) return;

        if (!b.available || LibrarySystemm.hasActiveReservation(b)) {
            error("This book is borrowed or reserved and cannot be removed.");
            return;
        }

        int confirm = JOptionPane.showConfirmDialog(
            this,
            "Remove " + b.title + "?",
            "Confirm Removal",
            JOptionPane.YES_NO_OPTION
        );

        if (confirm != JOptionPane.YES_OPTION) return;

        try (PreparedStatement ps =
                 LibrarySystemm.conn.prepareStatement(
                     "DELETE FROM Books WHERE book_id = ?")) {

            ps.setInt(1, b.id);

            if (ps.executeUpdate() > 0) {
                LibrarySystemm.recordUserActivity(
                    "Removed book: " + b.title
                );

                LibrarySystemm.refreshData();
                message("Book removed successfully.");
            }

            refreshCurrentBookPage();

        } catch (SQLException ex) {
            error("Remove failed: " + ex.getMessage());
        }
    }

