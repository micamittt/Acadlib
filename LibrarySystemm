    static int getTotalTransactions() {

        String sql = "SELECT COUNT(*) FROM BorrowingRecords WHERE user_id = ?";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, currentUserId);

            ResultSet rs = ps.executeQuery();

            int borrowed = 0;

            if (rs.next()) borrowed = rs.getInt(1);

            String reservationSQL = "SELECT COUNT(*) FROM Reservations WHERE user_id = ?";

            try (PreparedStatement reservationPS = conn.prepareStatement(reservationSQL)) {
                reservationPS.setInt(1, currentUserId);

                ResultSet reservationRS = reservationPS.executeQuery();

                if (reservationRS.next()) {
                    return borrowed + reservationRS.getInt(1);
                }
            }

        } catch (SQLException e) {
            System.out.println(e.getMessage());
        }

        return 0;
    }

