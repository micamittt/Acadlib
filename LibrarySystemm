    // DATABASE CONNECTION

    static Connection connectDB() {

        String url = "jdbc:mysql://localhost:3306/LibrarySystemm";
        String username = "root";
        String password = System.getenv("ACADLIB_DB_PASSWORD");

        if (password == null || password.isEmpty()) {
            System.out.println("Database password environment variable is missing.");
            System.out.println("Set ACADLIB_DB_PASSWORD in Windows first.");
            return null;
        }

        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection connection =
                DriverManager.getConnection(url, username, password);

            System.out.println("\nDatabase connected successfully!");
            return connection;

        } catch (ClassNotFoundException e) {
            System.out.println("MySQL JDBC Driver not found.");
            System.out.println("Check your MySQL Connector/J library.");

        } catch (SQLException e) {
            System.out.println("Database connection failed!");
            System.out.println(e.getMessage());
        }

        return null;
    }

