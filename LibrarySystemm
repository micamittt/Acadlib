    // RESERVATIONS

    static void reserveSelectedBook(Book book) {

        loadBooks();
        book = findBook(book.id);

        if (book == null || !book.available) {
            System.out.println("This book is unavailable.");
            return;
        }

        if (hasActiveReservation(book)) {
            System.out.println("This book is already reserved.");
            return;
        }

        System.out.println("Reservation is only allowed until 5:00 PM.");

        System.out.print("Enter reservation date (YYYY-MM-DD): ");
        String date = scanner.nextLine();

        LocalDate reservationDate;

        try {
            reservationDate = LocalDate.parse(date);
        } catch (DateTimeParseException e) {
            System.out.println("Invalid date. Use YYYY-MM-DD.");
            return;
        }

        if (reservationDate.isBefore(LocalDate.now())) {
            System.out.println("You cannot reserve a book for a past date.");
            return;
        }

        System.out.print("Enter reservation time (HH:MM AM/PM): ");
        String time = scanner.nextLine();

        LocalTime reservationTime = parseTime(time);

        if (reservationTime == null) {
            System.out.println("Invalid time format. Example: 4:30 PM.");
            return;
        }

        if (reservationTime.isAfter(LocalTime.of(17, 0))) {
            System.out.println("You can only reserve a book until 5:00 PM.");
            return;
        }

        String sql = "INSERT INTO Reservations "
                   + "(user_id, book_id, reservation_date, reservation_time, status) "
                   + "VALUES (?, ?, ?, ?, 'Active')";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, currentUserId);
            ps.setInt(2, book.id);
            ps.setDate(3, Date.valueOf(reservationDate));
            ps.setTime(4, Time.valueOf(reservationTime));
            ps.executeUpdate();

            recordUserActivity("Reserved book: " + book.title);

            System.out.println("\nReservation successful!");
            System.out.println("Book: " + book.title);
            System.out.println("Date: " + date);
            System.out.println("Time: " + time);
            System.out.println("Status: Active");
            System.out.println("Reservation deadline: 5:00 PM");

        } catch (SQLException e) {
            System.out.println("Reservation failed: " + e.getMessage());
        }
    }

    static LocalTime parseTime(String time) {

        DateTimeFormatter[] formats = {
            DateTimeFormatter.ofPattern("h:mm a"),
            DateTimeFormatter.ofPattern("hh:mm a"),
            DateTimeFormatter.ofPattern("H:mm")
        };

        for (DateTimeFormatter format : formats) {
            try {
                return LocalTime.parse(time.toUpperCase(), format);
            } catch (DateTimeParseException e) {
                // Try the next time format.
            }
        }

        return null;
    }

    static boolean hasActiveReservation(Book book) {

        String sql = "SELECT reservation_id FROM Reservations "
                   + "WHERE book_id = ? AND status = 'Active' "
                   + "AND reservation_date >= CURDATE()";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, book.id);

            ResultSet rs = ps.executeQuery();
            return rs.next();

        } catch (SQLException e) {
            System.out.println(e.getMessage());
            return false;
        }
    }

