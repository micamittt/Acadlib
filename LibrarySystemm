    static void editBook() {

        displayBooks();

        int id = getInteger("\nEnter Book ID to edit or 0 to go back: ");

        if (id == 0) return;

        Book book = findBook(id);

        if (book == null) {
            System.out.println("Book not found.");
            return;
        }

        System.out.println("\nLeave a field blank to keep its current information.");

        System.out.println("Current title: " + book.title);
        System.out.print("New title: ");
        String title = scanner.nextLine();

        System.out.println("Current author: " + book.author);
        System.out.print("New author: ");
        String author = scanner.nextLine();

        System.out.println("Current category: " + book.category);
        System.out.print("New category (Scholarly, Research, Capstone): ");
        String category = scanner.nextLine().trim();

        if (!category.isEmpty()
                && !category.equalsIgnoreCase("Scholarly")
                && !category.equalsIgnoreCase("Research")
                && !category.equalsIgnoreCase("Capstone")) {
            System.out.println("Invalid category.");
            return;
        }

        String sql = "UPDATE Books SET title = ?, author = ?, category = ? "
                   + "WHERE book_id = ?";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, title.trim().isEmpty() ? book.title : title);
            ps.setString(2, author.trim().isEmpty() ? book.author : author);
            ps.setString(3, category.trim().isEmpty() ? book.category : category);
            ps.setInt(4, id);

            ps.executeUpdate();

            recordUserActivity("Edited book ID " + id);
            System.out.println("Book information updated successfully!");

        } catch (SQLException e) {
            System.out.println("Could not update book: " + e.getMessage());
        }
    }

    static void removeBook() {

        displayBooks();

        int id = getInteger("\nEnter Book ID to remove or 0 to go back: ");

        if (id == 0) return;

        Book book = findBook(id);

        if (book == null) {
            System.out.println("Book not found.");
            return;
        }

        if (!book.available || hasActiveReservation(book)) {
            System.out.println("This book cannot be removed because it is borrowed or reserved.");
            return;
        }

        System.out.print("Are you sure you want to remove this book? (yes/no): ");
        String confirmation = scanner.nextLine();

        if (!confirmation.equalsIgnoreCase("yes")) {
            System.out.println("Book removal cancelled.");
            return;
        }

        String sql = "DELETE FROM Books WHERE book_id = ?";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, id);
            ps.executeUpdate();

            recordUserActivity("Removed book ID " + id);
            System.out.println("Book removed successfully.");

        } catch (SQLException e) {
            System.out.println("Could not remove book: " + e.getMessage());
        }
    }

