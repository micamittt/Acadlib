    // RETURN BOOK

    static void returnBook() {

        loadBorrowedBooks();

        System.out.println("\n--------------- RETURN BOOK ---------------");

        if (borrowedBooks.isEmpty()) {
            System.out.println("You currently have no borrowed books.");
            return;
        }

        System.out.println("\nYour borrowed books:");

        for (Book book : borrowedBooks) {
            System.out.println(book.id + ". " + book.title + " - " + book.author);
        }

        int id = getInteger("\nEnter Book ID to return: ");

        Book bookToReturn = null;

        for (Book book : borrowedBooks) {
            if (book.id == id) {
                bookToReturn = book;
                break;
            }
        }

        if (bookToReturn == null) {
            System.out.println("\nYou do not have this book borrowed.");
            return;
        }

        String updateRecord = "UPDATE BorrowingRecords "
                            + "SET status = 'Returned', return_date = NOW() "
                            + "WHERE user_id = ? AND book_id = ? "
                            + "AND status = 'Borrowed'";

        String updateBook = "UPDATE Books SET available = TRUE WHERE book_id = ?";

        try {
            conn.setAutoCommit(false);

            try (PreparedStatement recordPS = conn.prepareStatement(updateRecord);
                 PreparedStatement bookPS = conn.prepareStatement(updateBook)) {

                recordPS.setInt(1, currentUserId);
                recordPS.setInt(2, id);
                recordPS.executeUpdate();

                bookPS.setInt(1, id);
                bookPS.executeUpdate();

                conn.commit();

                recordUserActivity("Returned book: " + bookToReturn.title);

                System.out.println("\nBook returned successfully!");
                System.out.println("Book: " + bookToReturn.title);

            } catch (SQLException e) {
                conn.rollback();
                System.out.println("Return failed: " + e.getMessage());

            } finally {
                conn.setAutoCommit(true);
            }

        } catch (SQLException e) {
            System.out.println(e.getMessage());
        }
    }

    

