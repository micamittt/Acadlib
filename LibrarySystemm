    // LOAD DATABASE INFORMATION

    static void loadUsers() {

        users.clear();

        String sql = "SELECT * FROM Users";

        try (PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                users.add(new User(
                    rs.getInt("user_id"),
                    rs.getString("category"),
                    rs.getString("name"),
                    rs.getString("id_number"),
                    rs.getInt("age"),
                    rs.getString("program_year"),
                    rs.getString("email"),
                    rs.getString("password")
                ));
            }

        } catch (SQLException e) {
            System.out.println("Error loading users: " + e.getMessage());
        }
    }

    static void loadBooks() {

        books.clear();

        String sql = "SELECT * FROM Books";

        try (PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                books.add(new Book(
                    rs.getInt("book_id"),
                    rs.getString("title"),
                    rs.getString("category"),
                    rs.getString("author"),
                    rs.getBoolean("available")
                ));
            }

        } catch (SQLException e) {
            System.out.println("Error loading books: " + e.getMessage());
        }
    }

    static void loadBorrowedBooks() {

        borrowedBooks.clear();

        String sql = "SELECT b.* FROM Books b "
                   + "JOIN BorrowingRecords br ON b.book_id = br.book_id "
                   + "WHERE br.user_id = ? AND br.status = 'Borrowed'";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, currentUserId);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                borrowedBooks.add(new Book(
                    rs.getInt("book_id"),
                    rs.getString("title"),
                    rs.getString("category"),
                    rs.getString("author"),
                    rs.getBoolean("available")
                ));
            }

        } catch (SQLException e) {
            System.out.println("Error loading borrowed books: " + e.getMessage());
        }
    }

    static void loadReservations() {

        reservations.clear();

        String sql = "SELECT r.*, b.title, b.category, b.author, b.available "
                   + "FROM Reservations r "
                   + "JOIN Books b ON r.book_id = b.book_id";

        try (PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {

                Book book = new Book(
                    rs.getInt("book_id"),
                    rs.getString("title"),
                    rs.getString("category"),
                    rs.getString("author"),
                    rs.getBoolean("available")
                );

                reservations.add(new Reservation(
                    rs.getInt("reservation_id"),
                    book,
                    rs.getString("reservation_date"),
                    rs.getString("reservation_time"),
                    rs.getString("status"),
                    rs.getInt("user_id")
                ));
            }

        } catch (SQLException e) {
            System.out.println("Error loading reservations: " + e.getMessage());
        }
    }

