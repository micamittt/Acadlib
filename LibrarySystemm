    // LOGIN

    static boolean login() {

        int attempts = 3;

        while (attempts > 0) {

            System.out.println("\n--------------- SIGN-IN ---------------");

            System.out.print("Email: ");
            String enteredEmail = scanner.nextLine();

            System.out.print("Password: ");
            String enteredPassword = scanner.nextLine();

            System.out.print("Account Type (student or admin): ");
            String enteredAccountType = scanner.nextLine().toLowerCase();

            String sql = "SELECT * FROM Users "
                       + "WHERE email = ? AND password = ? AND category = ?";

            try (PreparedStatement ps = conn.prepareStatement(sql)) {

                ps.setString(1, enteredEmail);
                ps.setString(2, enteredPassword);
                ps.setString(3, enteredAccountType);

                ResultSet rs = ps.executeQuery();

                if (rs.next()) {

                    currentUserId = rs.getInt("user_id");

                    refreshData();

                    for (int i = 0; i < users.size(); i++) {
                        if (users.get(i).id == currentUserId) {
                            currentUser = i;
                            break;
                        }
                    }

                    recordUserActivity("Signed in");

                    System.out.println("\nLogin successful!");
                    System.out.println("Welcome, " + users.get(currentUser).name + "!");
                    System.out.println("Account Type: " + users.get(currentUser).category);
                    System.out.println("________________________________________________");

                    return true;
                }

            } catch (SQLException e) {
                System.out.println("Login error: " + e.getMessage());
                return false;
            }

            attempts--;

            if (attempts > 0) {
                System.out.println("\nIncorrect Email, Password, or Account Type.");
                System.out.println("Attempts remaining: " + attempts);
            } else {
                System.out.println("\nToo many failed login attempts.");
                System.out.println("Access denied.");
            }
        }

        return false;
    }

    // REGISTRATION

    static void register() {

        System.out.println("\n--------------- REGISTER ---------------");

        System.out.print("Account Type (student or admin): ");
        String category = scanner.nextLine().toLowerCase();

        while (!category.equals("student") && !category.equals("admin")) {
            System.out.println("Please enter only student or admin.");
            System.out.print("Account Type (student or admin): ");
            category = scanner.nextLine().toLowerCase();
        }

        System.out.print("Name: ");
        String name = scanner.nextLine();

        System.out.print("ID Number: ");
        String idNumber = scanner.nextLine();

        int age = getInteger("Age: ");

        System.out.print("Program and year: ");
        String programYear = scanner.nextLine();

        System.out.print("Email: ");
        String email = scanner.nextLine();

        while (emailExists(email)) {
            System.out.println("Email already registered.");
            System.out.print("Email: ");
            email = scanner.nextLine();
        }

        System.out.print("Password: ");
        String password = scanner.nextLine();

        String sql = "INSERT INTO Users "
                   + "(category, name, id_number, age, program_year, email, password) "
                   + "VALUES (?, ?, ?, ?, ?, ?, ?)";

        try (PreparedStatement ps = conn.prepareStatement(
                sql, Statement.RETURN_GENERATED_KEYS)) {

            ps.setString(1, category);
            ps.setString(2, name);
            ps.setString(3, idNumber);
            ps.setInt(4, age);
            ps.setString(5, programYear);
            ps.setString(6, email);
            ps.setString(7, password);

            ps.executeUpdate();

            ResultSet keys = ps.getGeneratedKeys();

            if (keys.next()) {
                int newUserId = keys.getInt(1);

                String cardNumber = "LIB-" + newUserId + "-" + idNumber;

                String cardSQL = "INSERT INTO LibraryCards "
                               + "(user_id, card_number) VALUES (?, ?)";

                try (PreparedStatement cardPS = conn.prepareStatement(cardSQL)) {
                    cardPS.setInt(1, newUserId);
                    cardPS.setString(2, cardNumber);
                    cardPS.executeUpdate();
                }

                currentUserId = newUserId;
                recordUserActivity("Registered an account");
                currentUserId = -1;
            }

            System.out.println("\nRegistration successful!");
            System.out.println("You can now sign in using your email and password.");

        } catch (SQLException e) {
            System.out.println("Registration failed: " + e.getMessage());
        }
    }

