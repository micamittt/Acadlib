    // BORROW BOOK

    static void borrowSelectedBook(Book book) {

        if (!users.get(currentUser).category.equalsIgnoreCase("student")) {
            System.out.println("Only student accounts can borrow books.");
            return;
        }

        loadBorrowedBooks();
        loadBooks();

        if (borrowedBooks.size() >= 3) {
            System.out.println("You have reached the maximum borrowing limit of 3 books.");
            return;
        }

        book = findBook(book.id);

        if (book == null || !book.available || hasActiveReservation(book)) {
            System.out.println("This book is currently unavailable.");
            return;
        }

        String updateSQL = "UPDATE Books SET available = FALSE "
                         + "WHERE book_id = ? AND available = TRUE";

        String insertSQL = "INSERT INTO BorrowingRecords "
                         + "(user_id, book_id, status) VALUES (?, ?, 'Borrowed')";

        try {
            conn.setAutoCommit(false);

            try (PreparedStatement updatePS = conn.prepareStatement(updateSQL);
                 PreparedStatement insertPS = conn.prepareStatement(insertSQL)) {

                updatePS.setInt(1, book.id);

                if (updatePS.executeUpdate() == 0) {
                    conn.rollback();
                    System.out.println("This book is no longer available.");
                    return;
                }

                insertPS.setInt(1, currentUserId);
                insertPS.setInt(2, book.id);
                insertPS.executeUpdate();

                conn.commit();

                recordUserActivity("Borrowed book: " + book.title);

                loadBorrowedBooks();

                System.out.println("\nBook borrowed successfully!");
                System.out.println("Book: " + book.title);
